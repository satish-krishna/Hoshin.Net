<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Hoshin.Workflow</RootNamespace>
    <AssemblyName>Hoshin.Workflow</AssemblyName>
    <PackageId>Hoshin.Workflow</PackageId>
    <Authors>SatishKrishna Pilla</Authors>
    <Description>Core .NET 10 workflow library for Hoshin.Net: JSONC document readers and validators, Layout 2 migration, state machine (WorkflowEngine.Next), detached worktree Red/Green runner, and embedded harness-neutral role procedures.</Description>
    <PackageTags>hoshin;workflow;gherkin;jsonc;tdd;agents</PackageTags>
    <RepositoryUrl>https://github.com/satish-krishna/Hoshin.Net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Gherkin" Version="43.0.0" />
    <PackageReference Include="Markdig" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Documents/Schemas/*.json" />
    <EmbeddedResource Include="Workspace/Templates/*.md" />
    <EmbeddedResource Include="..\..\skills\**\*.md" Link="skills\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
